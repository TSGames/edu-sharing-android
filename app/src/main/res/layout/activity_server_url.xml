<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server_url_prompt"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:paddingBottom="16dp" />

        <!-- Primary path: tapping a row connects immediately. Populated at runtime from
             ServerRegistry.fetch(); this whole section stays gone if the fetch returns
             nothing (offline, or the registry is unreachable) or while it's in flight. -->
        <TextView
            android:id="@+id/knownServersHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/server_url_known_servers_heading"
            android:textAppearance="?attr/textAppearanceOverline"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/knownServersProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/knownServersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Secondary path: manual entry. -->
        <TextView
            android:id="@+id/manualEntryHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingBottom="4dp"
            android:text="@string/server_url_manual_heading"
            android:textAppearance="?attr/textAppearanceOverline" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_url_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/serverUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:imeOptions="actionDone"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/server_url_continue" />

    </LinearLayout>

</ScrollView>
