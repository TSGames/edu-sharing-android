<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- System-bar insets are applied as WebView padding in code (see MainActivity.setupWebView),
         not via fitsSystemWindows, which isn't reliable under enforced edge-to-edge (API 35+). -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
